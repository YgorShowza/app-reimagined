# Frontend — pode ser exposto ao navegador
# No ambiente corporativo, mantenha REQUIRE_API=true para impedir fallback silencioso ao backend legado.
VITE_SEGEMPAT_API_URL="https://segempat-api.empresa.local"
VITE_SEGEMPAT_REQUIRE_API="true"

# Servidor — NUNCA prefixar com VITE_
SEGEMPAT_DB_DRIVER="mysql"
MYSQL_HOST=""
MYSQL_PORT="3306"
MYSQL_DATABASE="segempat"
MYSQL_USER="segempat_app"
MYSQL_PASSWORD=""
MYSQL_SSL="true"
SEGEMPAT_SESSION_SECRET=""
SEGEMPAT_STORAGE_DRIVER="filesystem"
SEGEMPAT_STORAGE_PATH=""

# Durante a fase de transição o Supabase pode continuar configurado no ambiente
# atual de preview. No build corporativo, VITE_SEGEMPAT_REQUIRE_API=true faz o
# frontend falhar de forma explícita se VITE_SEGEMPAT_API_URL estiver ausente,
# evitando que o sistema volte silenciosamente para o backend legado.
